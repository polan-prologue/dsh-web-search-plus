{
  "name": "dsh-web-search-plus",
  "version": "0.1.7",
  "description": "网页搜索++：DeepSeek 原生搜索与 Tavily 之间自由排序，多密钥轮换，交还即回官方。 · Provider priority for DSH web search with multi-key Tavily rotation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polan-prologue/dsh-web-search-plus.git"
  },
  "homepage": "https://github.com/polan-prologue/dsh-web-search-plus#readme",
  "bugs": {
    "url": "https://github.com/polan-prologue/dsh-web-search-plus/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "search-provider",
    "tavily",
    "search-priority",
    "key-rotation"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:live": "node tests/live-check.mjs",
    "prepack": "node tools/scan-sensitive.mjs"
  },
  "author": "polan-prologue"
}
